# 이 파일을 .env 로 복사한 뒤 실제 발급받은 키를 채워 넣으세요.
# .env 는 .gitignore 에 포함되어 있어 커밋되지 않습니다.

# DART Open API 키 — https://opendart.fss.or.kr (회원가입 > 인증키 신청/관리)
DART_API_KEY=

# 네이버 개발자센터 애플리케이션 키 — https://developers.naver.com/apps
# "검색" (뉴스검색) + "데이터랩(검색어트렌드)" API 를 동일 애플리케이션에 추가해야 함
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
